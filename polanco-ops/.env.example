NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

OPEN_EXCHANGE_RATES_APP_ID=

NEXT_PUBLIC_APP_URL=

# Error monitoring. Unset in local dev — Sentry.init() safely no-ops without
# a dsn (logs a notice, sends nothing) rather than failing. SENTRY_ORG/
# SENTRY_PROJECT/SENTRY_AUTH_TOKEN are only needed to upload sourcemaps at
# build time and can stay unset until a Sentry project actually exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
